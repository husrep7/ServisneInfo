DATABASE_URL=postgresql://servisneinfo:servisneinfo_pass@localhost:5434/servisneinfo_db
REDIS_URL=redis://localhost:6379
PORT=3000

# Token za admin endpointe (POST /scrape-now, /admin/*) — header: Authorization: Bearer <token>
ADMIN_TOKEN=

# Prijave: broj proxy hopova ispred servera (npr. 1 iza jednog load balancera; 0 bez proxyja)
TRUST_PROXY_HOPS=0
# Tajna so za hash IP adrese prijavioca (npr. openssl rand -hex 32)
IP_HASH_SALT=

# Anthropic (za LLM parsing adresa)
ANTHROPIC_API_KEY=your_key_here

# Expo push notifications
EXPO_ACCESS_TOKEN=your_expo_access_token

# Scraper intervali (u minutama)
SCRAPER_INTERVAL_MINUTES=15

# URL-ovi scrapers (opcionalno — defaulti su postavljeni u kodu)
VODOVOD_URL=https://www.viksa.ba/objave/servisne_informacije
ELEKTRO_URL=https://www.epbih.ba/index.php/bs/obavjestenja-o-iskljucenjima
SARAJEVOGAS_URL=https://www.sarajevogas.ba/novosti
TOPLANE_URL=https://www.toplanesarajevo.ba/korisnici/obavijest-o-radovima
BHTELEKOM_URL=https://www.bhtelecom.ba/bs/pomoc/smetnje

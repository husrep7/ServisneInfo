{
  "expo": {
    "name": "Komunalni Info",
    "slug": "komunalni-info",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "komunalniinfo",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1a73e8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ba.komunalniinfo.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Koristimo lokaciju da prikažemo incidente blizu vas.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "ba.komunalniinfo.app",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1a73e8"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Koristimo lokaciju da prikažemo incidente blizu vas i pošaljemo obavijesti za vaše područje."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1a73e8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
